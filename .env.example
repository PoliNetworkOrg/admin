BACKEND_URL="http://localhost:3000"

# Public native OAuth client for the downloadable Admin MCP (not the dashboard's confidential client).
# Register callback http://127.0.0.1:47322/callback and delegated backend:admin; see docs/mcp.md.
# ADMIN_MCP_CLIENT_ID=""
# Local preview: set to true to use a fake administrator without OIDC or Redis.
# Only works with pnpm dev and a local fake/test backend.
AGENT_MODE="false"

# Local user login: keep AGENT_MODE=false and configure a development client in the IdP.
# Register http://localhost:3001/auth/callback and http://localhost:3001/login.
# APP_URL="http://localhost:3001"
# IDP_URL="https://auth.polinetwork.org"
# OIDC_CLIENT_ID=""
# Set exactly one client credential, issued for that development client:
# OIDC_CLIENT_SECRET=""
# OIDC_CLIENT_PRIVATE_JWK='{"kty":"OKP","crv":"Ed25519","alg":"EdDSA","kid":"...","d":"...","x":"..."}'
# SESSION_SECRET="" # Generate an independent random value of at least 32 characters.
# REDIS_URL="redis://localhost:6379" # Dedicated local Redis instance.
